      "dialogues": [
        {
          "id": "dlg_payroll_pat",
          "startNodeId": "pat1",
          "nodes": [
            {
              "id": "pat1",
              "speaker": "Payroll Pat",
              "text": {
                "explorer": "Stamp came in! After the stall, we can split fun stuff AND a little keep \u2014 Clock buckets, when you\u2019re ready.",
                "apprentice": "Paycheck\u2019s here. Fountain\u2019s already a Harbor story. When you\u2019re ready, Priya stamps needs / wants / savings \u2014 Clock\u2019s new organ.",
                "strategist": "Income is in. The stall already wrote Harbor weather. Clock\u2019s next organ is allocation \u2014 50/30/20 if you want the Bureau."
              },
              "choices": [
                {
                  "id": "pat1_a",
                  "text": "Show me Clock buckets",
                  "nextNodeId": "pat2",
                  "effects": [
                    {
                      "type": "startQuest",
                      "questId": "q_pp_budget_basics"
                    }
                  ]
                },
                {
                  "id": "pat1_b",
                  "text": "I\u2019ll wander first.",
                  "nextNodeId": "pat3"
                }
              ]
            },
            {
              "id": "pat2",
              "speaker": "Payroll Pat",
              "text": "Clock\u2019s the stamp organ. Grab the paycheck here, then Priya\u2019s Bureau \u2014 buckets after the stall.",
              "end": true
            },
            {
              "id": "pat3",
              "speaker": "Payroll Pat",
              "text": "Fair enough! But if you change your mind, Planner Priya is over at the Budget Bureau.",
              "end": true
            }
          ]
        },
        {
          "id": "dlg_planner_priya",
          "startNodeId": "pri1",
          "nodes": [
            {
              "id": "pri1",
              "speaker": "Planner Priya",
              "text": "Welcome to the Budget Bureau! On this Coast the Clock stamps three payday buckets \u2014 needs, wants, and savings \u2014 so shelter sticks after the stamp. Ready to try?",
              "choices": [
                {
                  "id": "pri1_a",
                  "text": "Let's stamp the buckets!",
                  "nextNodeId": "pri2",
                  "effects": [
                    {
                      "type": "startMinigame",
                      "minigameId": "mg_budget_split"
                    }
                  ]
                },
                {
                  "id": "pri1_digress",
                  "text": "Digression \u2014 tip first or plan first?",
                  "nextNodeId": "pri_fork"
                },
                {
                  "id": "pri1_b",
                  "text": "Tell me more first.",
                  "nextNodeId": "pri3"
                }
              ]
            },
            {
              "id": "pri_fork",
              "speaker": "Planner Priya",
              "text": "Tip jar\u2019s ringing. Plan the three buckets first \u2014 or tip the glitter stall before you\u2019ve stamped?",
              "choices": [
                {
                  "id": "pri_plan",
                  "text": "Plan buckets first \u2014 Clock shelters \u00b7 quieter Main Street",
                  "nextNodeId": "pri_plan_done",
                  "effects": [
                    {
                      "type": "addScar",
                      "id": "pp_tip_plan",
                      "label": "Planned buckets before tipping",
                      "kind": "npc_tone",
                      "stance": "saver",
                      "stanceDelta": 1
                    }
                  ]
                },
                {
                  "id": "pri_tip",
                  "text": "Tip first \u2014 louder tip-jar weather \u00b7 Harbor still keeps it",
                  "nextNodeId": "pri_tip_done",
                  "effects": [
                    {
                      "type": "addScar",
                      "id": "pp_tip_rush",
                      "label": "Tipped Main Street before planning",
                      "kind": "npc_tone",
                      "stance": "spender",
                      "stanceDelta": 1
                    }
                  ]
                }
              ]
            },
            {
              "id": "pri_plan_done",
              "speaker": "Planner Priya",
              "text": "Shelter before glitter tips. Harbor may gossip that you planned first \u2014 Clock skill.",
              "end": true
            },
            {
              "id": "pri_tip_done",
              "speaker": "Planner Priya",
              "text": "Tips leave weather too. Harbor may gossip that you jingled before the stamp.",
              "end": true
            },
            {
              "id": "pri2",
              "speaker": "Planner Priya",
              "text": "Drag each expense into the right payday bucket. Rent and food are needs. Entertainment is a want. Stamp something into savings so the loft can stay dry.",
              "end": true
            },
            {
              "id": "pri3",
              "speaker": "Planner Priya",
              "text": "Needs are must-pays after a stamp \u2014 housing, food, transport. Wants are enjoy-but-skippable. Savings is future shelter. Three buckets, one stamp.",
              "end": true
            }
          ]
        },
        {
          "id": "dlg_coach_carlos",
          "startNodeId": "cc1",
          "nodes": [
            {
              "id": "cc1",
              "speaker": "Coach Carlos",
              "text": "Life throws curveballs \u2014 phones, shoes, rain. A Rainy Day Fund is Clock shelter you don\u2019t touch until then. Vee\u2019s stall already wrote today\u2019s weather; swing by if you want the long version.",
              "choices": [
                {
                  "id": "cc1_a",
                  "text": "Tell me about rainy-day funds",
                  "nextNodeId": "cc2",
                  "effects": [
                    {
                      "type": "startQuest",
                      "questId": "q_pp_rainy_day"
                    }
                  ]
                },
                {
                  "id": "cc1_b",
                  "text": "I'll manage without one.",
                  "nextNodeId": "cc3"
                }
              ]
            },
            {
              "id": "cc2",
              "speaker": "Coach Carlos",
              "text": "An emergency fund is money you don't touch unless something unexpected happens. Even saving a little each week adds up. Go talk to Vendor Vee \u2014 she'll show you what surprise expenses look like!",
              "end": true
            },
            {
              "id": "cc3",
              "speaker": "Coach Carlos",
              "text": "Bold strategy! But trust me, surprises always come. Swing by when you're ready.",
              "end": true
            }
          ]
        },
        {
          "id": "dlg_vendor_vee",
          "startNodeId": "vv1",
          "nodes": [
            {
              "id": "vv1",
              "speaker": "Vendor Vee",
              "text": "The fountain broke. Shelter kit\u2019s on the left \u2014 glitter\u2019s half-off until dusk. Harbor keeps whichever you pick.",
              "choices": [
                {
                  "id": "vv_protect",
                  "text": "Umbrella before glitter \u2014 Clock shelters \u00b7 quieter Main Street",
                  "nextNodeId": "vv_protect_end",
                  "effects": [
                    {
                      "type": "startQuest",
                      "questId": "q_pp_rainy_day"
                    },
                    {
                      "type": "setIrreversible",
                      "key": "paycheck_protect_vs_spend",
                      "choiceId": "protect",
                      "label": "Umbrella before glitter"
                    },
                    {
                      "type": "addScar",
                      "id": "pp_protector_plaque",
                      "label": "Umbrella before glitter",
                      "kind": "plaque",
                      "stance": "saver",
                      "stanceDelta": 2
                    },
                    {
                      "type": "giveItem",
                      "itemId": "pp_rainy_day_fund"
                    }
                  ]
                },
                {
                  "id": "vv_spend",
                  "text": "Glitter ate the umbrella \u2014 louder rain gossip \u00b7 Harbor still keeps it",
                  "nextNodeId": "vv_spend_end",
                  "effects": [
                    {
                      "type": "startQuest",
                      "questId": "q_pp_rainy_day"
                    },
                    {
                      "type": "setIrreversible",
                      "key": "paycheck_protect_vs_spend",
                      "choiceId": "spend",
                      "label": "Glitter ate the umbrella"
                    },
                    {
                      "type": "addScar",
                      "id": "pp_spender_plaque",
                      "label": "Glitter ate the umbrella",
                      "kind": "plaza_prop",
                      "stance": "spender",
                      "stanceDelta": 2
                    },
                    {
                      "type": "giveItem",
                      "itemId": "pp_rainy_day_fund"
                    }
                  ]
                }
              ]
            },
            {
              "id": "vv_protect_end",
              "speaker": "Vendor Vee",
              "text": "That's the Change. Harbor will remember you kept an umbrella when the sky cracked. Fly home \u2014 Piggy is waiting.",
              "end": true
            },
            {
              "id": "vv_spend_end",
              "speaker": "Vendor Vee",
              "text": "Glitter now, thinner pouch later. Harbor will show it \u2014 and you can still rebuild. Fly home changed either way.",
              "end": true
            }
          ]
        }
      ],
