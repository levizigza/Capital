      "dialogues": [
        {
          "id": "dlg_penny",
          "startNodeId": "p1",
          "nodes": [
            {
              "id": "p1",
              "speaker": "Penny the Trader",
              "text": "Welcome to Market Street! I'm Penny. Want to learn how to trade stocks, bonds, and more?",
              "choices": [
                {
                  "id": "p1c1",
                  "text": "Yes! Teach me about portfolios.",
                  "nextNodeId": "p2",
                  "effects": [
                    {
                      "type": "startQuest",
                      "questId": "q_portfolio_starter"
                    }
                  ]
                },
                {
                  "id": "p1c2",
                  "text": "Just browsing for now.",
                  "nextNodeId": "p3"
                }
              ]
            },
            {
              "id": "p2",
              "speaker": "Penny the Trader",
              "text": "Great! First rule: diversification. Don't put all your eggs in one basket. Take this Trading License \u2014 it'll get you into Broker Hall where Marcus can set up your paper trading account.",
              "choices": [
                {
                  "id": "p2c1",
                  "text": "Got it!",
                  "nextNodeId": "p2b",
                  "effects": [
                    {
                      "type": "giveItem",
                      "itemId": "fa_trading_license"
                    }
                  ]
                }
              ]
            },
            {
              "id": "p2b",
              "speaker": "Penny the Trader",
              "text": "Head to Broker Hall \u2014 it's connected from here. Marcus will show you the trading simulator. Good luck!",
              "end": true
            },
            {
              "id": "p3",
              "speaker": "Penny the Trader",
              "text": "No problem! Come back when you're ready to start. The markets will wait.",
              "end": true
            }
          ]
        },
        {
          "id": "dlg_marcus",
          "startNodeId": "m1",
          "nodes": [
            {
              "id": "m1",
              "speaker": "Marcus the Broker",
              "text": "Ah, you have a Trading License! Ready to try paper trading? You'll get $10,000 in virtual cash to build a portfolio over 30 simulated trading days.",
              "choices": [
                {
                  "id": "m1c1",
                  "text": "Let's trade!",
                  "nextNodeId": "m2",
                  "effects": [
                    {
                      "type": "startMinigame",
                      "minigameId": "mg_paper_trading"
                    }
                  ]
                },
                {
                  "id": "m1c2",
                  "text": "What's a portfolio?",
                  "nextNodeId": "m3"
                }
              ]
            },
            {
              "id": "m2",
              "speaker": "Marcus the Broker",
              "text": "Opening the trading floor now\u2026",
              "end": true
            },
            {
              "id": "m3",
              "speaker": "Marcus the Broker",
              "text": "A portfolio is your collection of investments \u2014 stocks, bonds, etc. The key is spreading your money across different asset types so one bad day doesn't wipe you out. That's diversification!",
              "choices": [
                {
                  "id": "m3c1",
                  "text": "Got it \u2014 let's trade!",
                  "nextNodeId": "m2",
                  "effects": [
                    {
                      "type": "startMinigame",
                      "minigameId": "mg_paper_trading"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "dlg_nina",
          "startNodeId": "n1",
          "nodes": [
            {
              "id": "n1",
              "speaker": "Nina the Analyst",
              "text": "Markets move on news. Bonds and stocks react very differently to the same headlines. Want to see how?",
              "choices": [
                {
                  "id": "n1c1",
                  "text": "Show me!",
                  "nextNodeId": "n2",
                  "effects": [
                    {
                      "type": "startQuest",
                      "questId": "q_bonds_vs_stocks"
                    },
                    {
                      "type": "startMinigame",
                      "minigameId": "mg_bonds_vs_stocks"
                    }
                  ]
                },
                {
                  "id": "n1c2",
                  "text": "What are bonds exactly?",
                  "nextNodeId": "n3"
                }
              ]
            },
            {
              "id": "n2",
              "speaker": "Nina the Analyst",
              "text": "Loading the scenario simulator\u2026",
              "end": true
            },
            {
              "id": "n3",
              "speaker": "Nina the Analyst",
              "text": "A bond is like an IOU. You lend money to a company or government, and they pay you back with interest. Bonds are usually less risky than stocks but offer lower returns. Ready to compare them?",
              "choices": [
                {
                  "id": "n3c1",
                  "text": "Let's do it!",
                  "nextNodeId": "n2",
                  "effects": [
                    {
                      "type": "startQuest",
                      "questId": "q_bonds_vs_stocks"
                    },
                    {
                      "type": "startMinigame",
                      "minigameId": "mg_bonds_vs_stocks"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "dlg_dr_fund",
          "startNodeId": "d1",
          "nodes": [
            {
              "id": "d1",
              "speaker": "Dr. Fund",
              "text": "Welcome to the ETF Research Lab! An ETF \u2014 Exchange-Traded Fund \u2014 bundles many assets together so you can invest in a whole market with one purchase. Want to become an ETF Detective?",
              "choices": [
                {
                  "id": "d1c1",
                  "text": "Absolutely!",
                  "nextNodeId": "d2",
                  "effects": [
                    {
                      "type": "startQuest",
                      "questId": "q_etf_detective"
                    },
                    {
                      "type": "startMinigame",
                      "minigameId": "mg_etf_detective"
                    }
                  ]
                },
                {
                  "id": "d1c2",
                  "text": "What makes ETFs different from stocks?",
                  "nextNodeId": "d3"
                }
              ]
            },
            {
              "id": "d2",
              "speaker": "Dr. Fund",
              "text": "Let me pull up the comparison terminal\u2026",
              "end": true
            },
            {
              "id": "d3",
              "speaker": "Dr. Fund",
              "text": "When you buy a stock, you own a piece of one company. An ETF is like a basket \u2014 it holds shares in many companies. You get instant diversification! But watch the fees \u2014 they eat into your returns over time.",
              "choices": [
                {
                  "id": "d3c1",
                  "text": "Let's compare some ETFs!",
                  "nextNodeId": "d2",
                  "effects": [
                    {
                      "type": "startQuest",
                      "questId": "q_etf_detective"
                    },
                    {
                      "type": "startMinigame",
                      "minigameId": "mg_etf_detective"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "dlg_old_timer",
          "startNodeId": "ot1",
          "nodes": [
            {
              "id": "ot1",
              "speaker": "Old Timer Walt",
              "text": "Been in markets for 40 years, kid. Want some free advice?",
              "choices": [
                {
                  "id": "ot1c1",
                  "text": "What's the #1 rule?",
                  "nextNodeId": "ot2"
                },
                {
                  "id": "ot1c2",
                  "text": "What's the biggest mistake beginners make?",
                  "nextNodeId": "ot3"
                }
              ]
            },
            {
              "id": "ot2",
              "speaker": "Old Timer Walt",
              "text": "Rule #1: Time in the market beats timing the market. Don't try to predict when to buy and sell. Just invest regularly, stay diversified, and let compound growth do the work.",
              "end": true
            },
            {
              "id": "ot3",
              "speaker": "Old Timer Walt",
              "text": "Panic selling. Markets drop 20-30% sometimes \u2014 it's normal. Beginners sell at the bottom and miss the recovery. If you have a long time horizon, stay the course.",
              "end": true
            }
          ]
        }
      ],
