        }
      ],
      "dialogues": [
        {
          "id": "dlg_fs_weather",
          "startNodeId": "start",
          "nodes": [
            {
              "id": "start",
              "speaker": "Weather Weaver",
              "text": "Market weather paints these isles. Diversify baskets before the aurora flips — one storm shouldn't sink every raft.",
              "choices": [
                {
                  "id": "c_ok",
                  "text": "I'll rebalance before the front hits.",
                  "nextNodeId": "done",
                  "effects": [
                    {
                      "type": "startQuest",
                      "questId": "q_fs_weather_walk"
                    }
                  ]
                },
                {
                  "id": "c_bye",
                  "text": "Just looking.",
                  "nextNodeId": "done"
                }
              ]
            },
            {
              "id": "done",
              "speaker": "Weather Weaver",
              "text": "Horizon patience beats chasing every gust.",
              "end": true
            }
          ]
        },
        {
          "id": "dlg_fs_dock",
          "startNodeId": "start",
          "nodes": [
            {
              "id": "start",
              "speaker": "Dock Steward",
              "text": "Community dock is where sky gardens trade shade and seed. Budget the districts before you float a new raft.",
              "choices": [
                {
                  "id": "c1",
                  "text": "Show me the sky budget idea.",
                  "nextNodeId": "budget"
                },
                {
                  "id": "c2",
                  "text": "I'll walk the pier.",
                  "nextNodeId": "bye"
                }
              ]
            },
            {
              "id": "budget",
              "speaker": "Dock Steward",
              "text": "Needs · wants · reserves — same three buckets, just painted under aurora.",
              "end": true
            },
            {
              "id": "bye",
              "speaker": "Dock Steward",
              "text": "Carpet's ready when you are.",
              "end": true
            }
          ]
        },
        {
          "id": "dlg_future_keeper",
          "startNodeId": "start",
          "nodes": [
            {
              "id": "start",
              "speaker": "The Keeper",
              "text": "Welcome to Future Shores. We left this island unfinished on purpose. The Flash kids had their sites. The Poptropica kids had their islands. Now it's your turn — carve out games for your era in VibeCode Studio.",
              "choices": [
                {
                  "id": "c1",
                  "text": "So I get to build what comes next?",
                  "nextNodeId": "build"
                },
                {
                  "id": "c_listen",
                  "text": "Digression — study or claim first?",
                  "nextNodeId": "scaffold_fork"
                },
                {
                  "id": "c2",
                  "text": "What happened to the old islands?",
                  "nextNodeId": "old"
                }
              ]
            },
            {
              "id": "scaffold_fork",
              "speaker": "The Keeper",
              "text": "Unfinished poles lean your way. Study the scaffolding — or claim a plot before you’ve looked?",
              "choices": [
                {
                  "id": "c_look",
                  "text": "Study the scaffolding first.",
                  "nextNodeId": "listen_done",
                  "effects": [
                    {
                      "type": "addScar",
                      "id": "fs_scaffold_look",
                      "label": "Looked over Portfolio Skies scaffolding",
                      "kind": "npc_tone",
                      "stance": "saver",
                      "stanceDelta": 1
                    }
                  ]
                },
                {
                  "id": "c_rush",
                  "text": "Claim a plot cold — I’ll study later.",
                  "nextNodeId": "rush_done",
                  "effects": [
                    {
                      "type": "addScar",
                      "id": "fs_scaffold_rush",
                      "label": "Claimed Portfolio Skies plot cold",
                      "kind": "npc_tone",
                      "stance": "spender",
                      "stanceDelta": 1
                    }
                  ]
                }
              ]
            },
            {
              "id": "listen_done",
              "speaker": "The Keeper",
              "text": "Standing in unfinished space before you claim it is a money skill. Harbor may gossip that you studied the scaffolding.",
              "end": true
            },
            {
              "id": "rush_done",
              "speaker": "The Keeper",
              "text": "Claiming before looking leaves sparks. Harbor may gossip that you grabbed a pole cold.",
              "end": true
            },
            {
              "id": "build",
              "speaker": "The Keeper",
              "text": "Exactly. Sail to the other islands to see how each era looked — Poptropica sketch, Flash flat, Miniclip glossy. Then come back here and make something nobody's seen before.",
              "end": true,
              "choices": [
                {
                  "id": "c3",
                  "text": "I'm ready to explore.",
                  "effects": [
                    {
                      "type": "startQuest",
                      "questId": "q_fs_claim_plot"
                    }
                  ]
                }
              ]
            },
            {
              "id": "old",
              "speaker": "The Keeper",
              "text": "They're still out there — each island keeps its own animation style. Your character morphs when you land. But this shore? It's all scaffolding until you and your friends fill it in.",
              "end": true,
              "choices": [
                {
                  "id": "c4",
                  "text": "Let me look around.",
                  "effects": [
                    {
                      "type": "startQuest",
                      "questId": "q_fs_claim_plot"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
