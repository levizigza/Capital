      "dialogues": [
        {
          "id": "dlg_satoshi",
          "startNodeId": "s1",
          "nodes": [
            {
              "id": "s1",
              "speaker": "Satoshi the Guide",
              "text": "Welcome to Wallet Wharf! A crypto wallet doesn't actually hold coins \u2014 it holds the keys that prove ownership. Let me show you how it works.",
              "choices": [
                {
                  "id": "s1c1",
                  "text": "Set up my wallet!",
                  "nextNodeId": "s2",
                  "effects": [
                    {
                      "type": "startQuest",
                      "questId": "q_wallet_setup"
                    },
                    {
                      "type": "giveItem",
                      "itemId": "da_wallet_key"
                    }
                  ]
                },
                {
                  "id": "s1_listen",
                  "text": "Digression \u2014 listen or sign first?",
                  "nextNodeId": "s_fork"
                },
                {
                  "id": "s1c2",
                  "text": "What's a private key?",
                  "nextNodeId": "s3"
                }
              ]
            },
            {
              "id": "s2",
              "speaker": "Satoshi the Guide",
              "text": "Here's your seed phrase \u2014 12 random words that can recover your wallet. Never share it! Now head to Exchange Plaza to make your first trade.",
              "end": true
            },
            {
              "id": "s_fork",
              "speaker": "Satoshi the Guide",
              "text": "Wharf clicks loud. Listen for keys \u2014 or sign a wallet before you\u2019ve heard the pier?",
              "choices": [
                {
                  "id": "s_linger",
                  "text": "Listen at the wharf first.",
                  "nextNodeId": "s_listen_done",
                  "effects": [
                    {
                      "type": "addScar",
                      "id": "da_wharf_listen",
                      "label": "Listened at Wallet Wharf",
                      "kind": "npc_tone",
                      "stance": "saver",
                      "stanceDelta": 1
                    }
                  ]
                },
                {
                  "id": "s_rush",
                  "text": "Sign first \u2014 I\u2019ll learn the pier later.",
                  "nextNodeId": "s_rush_done",
                  "effects": [
                    {
                      "type": "addScar",
                      "id": "da_wharf_rush",
                      "label": "Signed Wallet Wharf keys cold",
                      "kind": "npc_tone",
                      "stance": "spender",
                      "stanceDelta": 1
                    }
                  ]
                }
              ]
            },
            {
              "id": "s_listen_done",
              "speaker": "Satoshi the Guide",
              "text": "Hearing the wharf before you sign is a money skill. Harbor may gossip that you listened first.",
              "end": true
            },
            {
              "id": "s_rush_done",
              "speaker": "Satoshi the Guide",
              "text": "Keys without the pier story leave sparks. Harbor may gossip that you signed cold.",
              "end": true
            },
            {
              "id": "s3",
              "speaker": "Satoshi the Guide",
              "text": "Think of it like a password that signs every transaction. Your public key is like your email address \u2014 anyone can send you crypto. But only you can send crypto out, using your private key.",
              "choices": [
                {
                  "id": "s3c1",
                  "text": "Create my wallet!",
                  "nextNodeId": "s2",
                  "effects": [
                    {
                      "type": "startQuest",
                      "questId": "q_wallet_setup"
                    },
                    {
                      "type": "giveItem",
                      "itemId": "da_wallet_key"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "dlg_emma",
          "startNodeId": "e1",
          "nodes": [
            {
              "id": "e1",
              "speaker": "Exchange Emma",
              "text": "This is the Exchange! You can buy and sell digital assets here. Every transaction has a fee \u2014 we call it 'gas'. Want to try a mock trade?",
              "choices": [
                {
                  "id": "e1c1",
                  "text": "Let's trade!",
                  "nextNodeId": "e2",
                  "effects": [
                    {
                      "type": "startMinigame",
                      "minigameId": "mg_mock_exchange"
                    }
                  ]
                },
                {
                  "id": "e1c2",
                  "text": "How do fees work?",
                  "nextNodeId": "e3"
                }
              ]
            },
            {
              "id": "e2",
              "speaker": "Exchange Emma",
              "text": "Opening the exchange simulator\u2026",
              "end": true
            },
            {
              "id": "e3",
              "speaker": "Exchange Emma",
              "text": "Every transaction on the blockchain costs a small fee that goes to 'miners' or 'validators' who process it. Fees spike when the network is busy \u2014 sometimes a $10 transfer costs $50 in fees!",
              "choices": [
                {
                  "id": "e3c1",
                  "text": "Okay, let me try trading!",
                  "nextNodeId": "e2",
                  "effects": [
                    {
                      "type": "startMinigame",
                      "minigameId": "mg_mock_exchange"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "dlg_fred",
          "startNodeId": "f1",
          "nodes": [
            {
              "id": "f1",
              "speaker": "FOMO Fred",
              "text": "BRO! CryptoCoin is up 300% this week! I'm going ALL IN! You should too before it's too late!!",
              "choices": [
                {
                  "id": "f1c1",
                  "text": "That sounds risky\u2026",
                  "nextNodeId": "f2"
                },
                {
                  "id": "f1c2",
                  "text": "What if it crashes?",
                  "nextNodeId": "f3"
                }
              ]
            },
            {
              "id": "f2",
              "speaker": "FOMO Fred",
              "text": "Risk?! The only risk is missing out! \u2026okay fine, last time I went all-in on MoonToken and lost 80%. But THIS TIME is different!",
              "end": true
            },
            {
              "id": "f3",
              "speaker": "FOMO Fred",
              "text": "Crashes are just buying opportunities! \u2026although I did panic-sell my whole portfolio at the bottom last time. Don't be like me. Maybe talk to Hannah \u2014 she's way calmer about this stuff.",
              "end": true
            }
          ]
        },
        {
          "id": "dlg_hannah",
          "startNodeId": "h1",
          "nodes": [
            {
              "id": "h1",
              "speaker": "HODL Hannah",
              "text": "Ignore the hype and the FUD. If you believe in the technology long-term, hold through the volatility. But never invest more than you can afford to lose.",
              "choices": [
                {
                  "id": "h1c1",
                  "text": "What's the #1 mistake in crypto?",
                  "nextNodeId": "h2",
                  "effects": [
                    {
                      "type": "startQuest",
                      "questId": "q_volatility_lesson"
                    }
                  ]
                },
                {
                  "id": "h1c2",
                  "text": "Thanks for the wisdom.",
                  "nextNodeId": "h3"
                }
              ]
            },
            {
              "id": "h2",
              "speaker": "HODL Hannah",
              "text": "Investing with emotion. People buy when they're euphoric and sell when they're terrified \u2014 the exact opposite of what works. Study the Volatility Report and you'll understand.",
              "end": true
            },
            {
              "id": "h3",
              "speaker": "HODL Hannah",
              "text": "Stay grounded. \ud83d\udc8e\ud83e\udd32",
              "end": true
            }
          ]
        }
      ],
